{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ruta-direct-gestor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "demo"
  }
}
