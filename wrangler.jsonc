{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestor",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "demo",
    "ML_CLIENT_ID": "566450472142174",
    "ML_REDIRECT_URI": "https://gestor.lnogueiralopes.workers.dev/api/marketplaces/mercadolivre/callback",
    "SUPABASE_URL": "https://hgxeybqujthsucfhejqx.supabase.co"
  },
  "keep_vars": true,
  "observability": { "logs": { "enabled": true } }
}
